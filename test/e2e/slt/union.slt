# union.slt - Union derived table, duplicate elimination, ordering, and schema validation

statement ok
CREATE TABLE u_orders1 (order_id INT, amount FLOAT, region CHAR(10));

statement ok
CREATE TABLE u_orders2 (order_id INT, amount FLOAT, region CHAR(10));

statement ok
CREATE TABLE u_orders3 (order_id INT, amount FLOAT, region CHAR(10));

statement ok
INSERT INTO u_orders1 VALUES (1, 150.0, 'Beijing');

statement ok
