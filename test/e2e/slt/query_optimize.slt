query
SELECT c.name, o.order_id FROM customers c JOIN orders o ON c.customer_id = o.customer_id;
----
+------------------+------------------+
|             name |         order_id |
+------------------+------------------+
|            Alice |              101 |
|            Alice |              102 |
|              Bob |              103 |
|              Bob |              104 |
|            Carol |              105 |
+------------------+------------------+
Total record(s): 5

query
EXPLAIN ANALYZE SELECT c.name, o.order_id FROM customers c JOIN orders o ON c.customer_id = o.customer_id;
----
Project(columns=[c.name, o.order_id], rows=5)
	Join(tables=[customers, orders], condition=[c.customer_id=o.customer_id], rows=5)
		Project(columns=[c.customer_id, c.name], rows=3)
			Scan(table=customers, type=SeqScan, rows=3)
		Project(columns=[o.customer_id, o.order_id], rows=15)
			Scan(table=orders, type=SeqScan, rows=15)

query
EXPLAIN ANALYZE SELECT c.name, o.order_id FROM customers c JOIN orders o ON c.customer_id = o.customer_id WHERE o.total_amount > 1000.0;
----
Project(columns=[c.name, o.order_id], rows=2)
	Join(tables=[customers, orders], condition=[c.customer_id=o.customer_id], rows=2)
		Project(columns=[c.customer_id, c.name], rows=3)
			Scan(table=customers, type=SeqScan, rows=3)
		Project(columns=[o.customer_id, o.order_id], rows=6)
			Filter(condition=[o.total_amount>1000.0], rows=6)
				Scan(table=orders, type=SeqScan, rows=15)

query
EXPLAIN ANALYZE SELECT c.name, o.order_id FROM customers c JOIN orders o ON c.customer_id = o.customer_id WHERE o.total_amount > 1000.00;
----
Project(columns=[c.name, o.order_id], rows=2)
	Join(tables=[customers, orders], condition=[c.customer_id=o.customer_id], rows=2)
		Project(columns=[c.customer_id, c.name], rows=3)
			Scan(table=customers, type=SeqScan, rows=3)
		Project(columns=[o.customer_id, o.order_id], rows=6)
			Filter(condition=[o.total_amount>1000.00], rows=6)
				Scan(table=orders, type=SeqScan, rows=15)

query
SELECT * FROM customers c JOIN orders o ON c.customer_id = o.customer_id WHERE o.total_amount > 1000;
----
+------------------+------------------+------------------+------------------+------------------+------------------+------------------+------------------+
|      customer_id |             name |            email |          address |         order_id |      customer_id |       order_date |     total_amount |
+------------------+------------------+------------------+------------------+------------------+------------------+------------------+------------------+
|                1 |            Alice | alice@example... |         A Street |              102 |                1 |       2025-01-02 |      1200.000000 |
|                2 |              Bob |  bob@example.com |         B Street |              104 |                2 |       2025-01-04 |      1500.000000 |
+------------------+------------------+------------------+------------------+------------------+------------------+------------------+------------------+
Total record(s): 2

query
EXPLAIN ANALYZE SELECT * FROM customers c JOIN orders o ON c.customer_id = o.customer_id WHERE o.total_amount > 1000;
----
Project(columns=[*], rows=2)
	Join(tables=[customers, orders], condition=[c.customer_id=o.customer_id], rows=2)
		Scan(table=customers, type=SeqScan, rows=3)
		Filter(condition=[o.total_amount>1000], rows=6)
			Scan(table=orders, type=SeqScan, rows=15)

query
SELECT * FROM orders o JOIN customers c ON o.customer_id = c.customer_id WHERE o.total_amount > 1000;
----
+------------------+------------------+------------------+------------------+------------------+------------------+------------------+------------------+
|         order_id |      customer_id |       order_date |     total_amount |      customer_id |             name |            email |          address |
+------------------+------------------+------------------+------------------+------------------+------------------+------------------+------------------+
|              102 |                1 |       2025-01-02 |      1200.000000 |                1 |            Alice | alice@example... |         A Street |
|              104 |                2 |       2025-01-04 |      1500.000000 |                2 |              Bob |  bob@example.com |         B Street |
+------------------+------------------+------------------+------------------+------------------+------------------+------------------+------------------+
Total record(s): 2

query
EXPLAIN ANALYZE SELECT * FROM orders o JOIN customers c ON o.customer_id = c.customer_id WHERE o.total_amount > 1000;
----
Project(columns=[*], rows=2)
	Join(tables=[customers, orders], condition=[o.customer_id=c.customer_id], rows=2)
		Scan(table=customers, type=SeqScan, rows=3)
		Filter(condition=[o.total_amount>1000], rows=6)
			Scan(table=orders, type=SeqScan, rows=15)

query
EXPLAIN ANALYZE SELECT c.name, o.order_id, p.payment_id FROM orders o JOIN payments p ON o.order_id = p.order_id JOIN customers c ON o.customer_id = c.customer_id WHERE o.total_amount > 1000.00 AND p.amount >= 1200.00;
----
Project(columns=[c.name, o.order_id, p.payment_id], rows=2)
	Join(tables=[customers, orders, payments], condition=[o.customer_id=c.customer_id], rows=2)
		Join(tables=[orders, payments], condition=[o.order_id=p.order_id], rows=2)
			Project(columns=[o.customer_id, o.order_id], rows=2)
				Filter(condition=[o.total_amount>1000.00], rows=2)
					Scan(table=orders, type=SeqScan, rows=5)
			Project(columns=[p.order_id, p.payment_id], rows=4)
				Filter(condition=[p.amount>=1200.00], rows=4)
					Scan(table=payments, type=SeqScan, rows=10)
		Project(columns=[c.customer_id, c.name], rows=6)
			Scan(table=customers, type=SeqScan, rows=6)
