INSERT INTO orders VALUES (103, 2, '2025-01-03', 900.0);

statement ok
INSERT INTO orders VALUES (104, 2, '2025-01-04', 1500.0);

statement ok
INSERT INTO orders VALUES (105, 3, '2025-01-05', 700.0);

