# aggregate.slt — aggregate functions, GROUP BY, HAVING, ORDER BY and LIMIT

statement ok
CREATE TABLE grade (course CHAR(20), id INT, score FLOAT);

statement ok
INSERT INTO grade VALUES ('DataStructure', 1, 95);

statement ok
