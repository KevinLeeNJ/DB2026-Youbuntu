# --- Create index on id ---
statement ok
CREATE INDEX items (id);

# Verify index metadata
query
SHOW INDEX FROM items;
----
+------------------+------------------+------------------+
|           Tables |             Type |           Column |
+------------------+------------------+------------------+
|            items |           unique |             (id) |
+------------------+------------------+------------------+

# --- Point query via index ---
query
SELECT * FROM items WHERE id = 15;
----
+------------------+------------------+------------------+
|               id |             name |            value |
+------------------+------------------+------------------+
|               15 |              u15 |       150.500000 |
+------------------+------------------+------------------+
Total record(s): 1

query
SELECT name, value FROM items WHERE id = 25;
----
+------------------+------------------+
|             name |            value |
+------------------+------------------+
|              u25 |       250.500000 |
+------------------+------------------+
Total record(s): 1

# --- Range query: id > 25 ---
query
SELECT id, name FROM items WHERE id > 25;
----
+------------------+------------------+
|               id |             name |
+------------------+------------------+
|               26 |              u26 |
|               27 |              u27 |
|               28 |              u28 |
|               29 |              u29 |
|               30 |              u30 |
+------------------+------------------+
Total record(s): 5

# --- Range query: id >= 20 AND id <= 23 ---
query
SELECT id, name, value FROM items WHERE id >= 20 AND id <= 23;
----
+------------------+------------------+------------------+
|               id |             name |            value |
+------------------+------------------+------------------+
|               20 |              u20 |       200.500000 |
|               21 |              u21 |       210.500000 |
|               22 |              u22 |       220.500000 |
|               23 |              u23 |       230.500000 |
+------------------+------------------+------------------+
Total record(s): 4

# --- Range query: id < 5 ---
query
SELECT id, name FROM items WHERE id < 5;
----
+------------------+------------------+
|               id |             name |
+------------------+------------------+
|                1 |              u01 |
|                2 |              u02 |
|                3 |              u03 |
|                4 |              u04 |
+------------------+------------------+
Total record(s): 4

# --- Duplicate key still rejected ---
statement error
INSERT INTO items VALUES (15, 'dup', 999.0);
