+------------------+
|     updated_name |
+------------------+
|              BOB |
+------------------+
Total record(s): 1

statement ok
CREATE TABLE fc_thresholds (score FLOAT);

statement ok
INSERT INTO fc_thresholds VALUES (0.0);

statement ok
INSERT INTO fc_thresholds VALUES (3.0);

query
SELECT id FROM fc_values WHERE score > SOME (SELECT score FROM fc_thresholds) ORDER BY 1;
