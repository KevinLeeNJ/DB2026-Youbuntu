statement ok
INSERT INTO fc_left VALUES (2, 'L2');

statement ok
CREATE TABLE fc_right (id INT, label CHAR(8));

statement ok
INSERT INTO fc_right VALUES (2, 'R2');

statement ok
INSERT INTO fc_right VALUES (3, 'R3');

query
SELECT l.id, LOWER(r.label) AS label FROM fc_left AS l INNER JOIN fc_right AS r ON l.id = r.id ORDER BY 1;
----
+------------------+------------------+
|               id |            label |
+------------------+------------------+
|                2 |               r2 |
+------------------+------------------+
Total record(s): 1

query
SELECT l.id, LOWER(r.label) AS label
FROM fc_left AS l LEFT JOIN fc_right AS r ON l.id = r.id ORDER BY 1;
----
+------------------+------------------+
|               id |            label |
+------------------+------------------+
|                1 |             NULL |
|                2 |               r2 |
+------------------+------------------+
Total record(s): 2

query
SELECT SUM(DISTINCT score) AS distinct_sum, AVG(DISTINCT score) AS distinct_avg,
       MIN(DISTINCT score) AS distinct_min, MAX(DISTINCT score) AS distinct_max
FROM fc_values;
----
+------------------+------------------+------------------+------------------+
|     distinct_sum |     distinct_avg |     distinct_min |     distinct_max |
+------------------+------------------+------------------+------------------+
|        -0.200000 |        -0.100000 |        -2.600000 |         2.400000 |
+------------------+------------------+------------------+------------------+
Total record(s): 1

query
SELECT * FROM (SELECT id FROM fc_values WHERE id < 3 UNION SELECT id FROM fc_values WHERE id = 3) AS u
ORDER BY 1 DESC;
