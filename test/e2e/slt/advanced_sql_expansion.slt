|                2 |
+------------------+
Total record(s): 1

query
SELECT l.id AS left_id, r.id AS right_id FROM adv_left AS l LEFT JOIN adv_right AS r ON l.id = r.id ORDER BY r.id NULLS FIRST, l.id DESC NULLS LAST;
----
+------------------+------------------+
|          left_id |         right_id |
+------------------+------------------+
|                1 |             NULL |
|                2 |                2 |
+------------------+------------------+
Total record(s): 2

