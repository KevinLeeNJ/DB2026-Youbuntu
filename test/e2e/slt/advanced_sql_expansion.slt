query
SELECT id, CASE WHEN score >= 20 THEN 'pass' ELSE 'fail' END AS status FROM adv_people ORDER BY id;
----
+------------------+------------------+
|               id |           status |
+------------------+------------------+
|                1 |             fail |
|                2 |             pass |
|                3 |             pass |
|                4 |             pass |
+------------------+------------------+
Total record(s): 4

query
SELECT COUNT(*) AS missing_case FROM adv_people WHERE CASE WHEN score >= 20 THEN 1 END IS NULL;
----
+------------------+
|     missing_case |
+------------------+
|                1 |
+------------------+
Total record(s): 1

query
SELECT l.id AS left_id FROM adv_left AS l LEFT JOIN adv_right AS r ON l.id = r.id WHERE r.id IS NULL;
----
+------------------+
|          left_id |
+------------------+
|                1 |
+------------------+
Total record(s): 1

query
SELECT r.id AS right_id FROM adv_left l LEFT JOIN adv_right r ON l.id = r.id WHERE r.id IS NOT NULL;
----
+------------------+
|         right_id |
+------------------+
|                2 |
+------------------+
Total record(s): 1

query
SELECT l.id FROM adv_left AS l WHERE EXISTS (SELECT r.id FROM adv_right AS r WHERE r.id = l.id) ORDER BY l.id;
----
+------------------+
|               id |
+------------------+
|                2 |
+------------------+
Total record(s): 1

query
SELECT l.id FROM adv_left AS l WHERE NOT EXISTS (SELECT r.id FROM adv_right AS r WHERE r.id = l.id) ORDER BY l.id;
----
+------------------+
|               id |
+------------------+
|                1 |
+------------------+
Total record(s): 1

query
SELECT id FROM adv_people WHERE score > ANY (SELECT score FROM adv_other) ORDER BY id;
