statement ok
CREATE TABLE ex_join_left (id INT, kind INT);

statement ok
INSERT INTO ex_join_left VALUES (1, 10);

statement ok
INSERT INTO ex_join_left VALUES (2, 20);

statement ok
CREATE TABLE ex_join_right (id INT, kind INT);

statement ok
INSERT INTO ex_join_right VALUES (1, 99);

statement ok
INSERT INTO ex_join_right VALUES (3, 20);

query
SELECT l.id AS left_id, r.id AS right_id FROM ex_join_left l JOIN ex_join_right r ON l.id = r.id OR l.kind = r.kind ORDER BY left_id;
----
+------------------+------------------+
|          left_id |         right_id |
+------------------+------------------+
|                1 |                1 |
|                2 |                3 |
+------------------+------------------+
Total record(s): 2

query
SELECT l.id AS left_id, r.id AS right_id FROM ex_join_left l JOIN ex_join_right r ON NOT (l.id <> r.id AND l.kind <> r.kind) ORDER BY left_id;
----
+------------------+------------------+
|          left_id |         right_id |
+------------------+------------------+
|                1 |                1 |
|                2 |                3 |
+------------------+------------------+
Total record(s): 2

