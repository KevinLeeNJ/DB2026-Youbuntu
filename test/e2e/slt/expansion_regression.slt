query
EXPLAIN ANALYZE SELECT l.id FROM ex_join_left l JOIN ex_join_right r ON l.id = r.id OR l.kind = r.kind;
----
Project(columns=[l.id], rows=2)
	Join(tables=[ex_join_left, ex_join_right], condition=[(l.id=r.id OR l.kind=r.kind)], rows=2)
		Scan(table=ex_join_left, type=SeqScan, rows=2)
		Scan(table=ex_join_right, type=SeqScan, rows=4)

