query
SELECT COUNT(*) AS n FROM ex_having HAVING COUNT(*) IS NOT NULL;
----
+------------------+
|                n |
+------------------+
|                5 |
+------------------+
Total record(s): 1

query
SELECT grp, COUNT(*) AS n FROM ex_having GROUP BY grp HAVING COUNT(*) = 1 OR SUM(val) > 10 ORDER BY grp;
----
+------------------+------------------+
|              grp |                n |
+------------------+------------------+
|                1 |                2 |
|                2 |                1 |
+------------------+------------------+
Total record(s): 2

query
SELECT grp, COUNT(*) AS n FROM ex_having GROUP BY grp HAVING NOT (COUNT(*) <> 1 AND SUM(val) <= 10) ORDER BY grp;
----
+------------------+------------------+
|              grp |                n |
+------------------+------------------+
|                1 |                2 |
|                2 |                1 |
+------------------+------------------+
Total record(s): 2

