query
SELECT * FROM (
    SELECT NULL AS value FROM ex_null_type
    UNION
    SELECT 'text' AS value FROM ex_null_type
) AS typed_union
ORDER BY value;
----
+------------------+
|            value |
+------------------+
|             NULL |
|             text |
+------------------+
Total record(s): 2

query
SELECT * FROM (
    SELECT 'text' AS value FROM ex_null_type
    UNION
    SELECT NULL AS value FROM ex_null_type
) AS typed_union
ORDER BY value;
