# null_aggregate.slt — 聚合的 NULL 语义：跳过 NULL 输入、COUNT(col) vs COUNT(*)、
# COUNT(DISTINCT) 不计 NULL、真正的空输入按 finalv3 A.3 为整数聚合输出 0、
# 非空全 NULL 输入仍输出 NULL、GROUP BY 把 NULL 当独立分组。

statement ok
CREATE TABLE na (g INT, v INT, w FLOAT, s CHAR(8));

statement ok
INSERT INTO na VALUES (1, 10, 1.0, 'a');

statement ok
INSERT INTO na VALUES (1, NULL, NULL, NULL);

statement ok
INSERT INTO na VALUES (1, 30, 3.0, 'c');

statement ok
INSERT INTO na VALUES (2, NULL, NULL, NULL);

statement ok
INSERT INTO na VALUES (2, 20, 2.0, 'a');

# COUNT(*) 数所有行；COUNT(col) 跳过 NULL
query
SELECT COUNT(*) FROM na;
----
+------------------+
|         COUNT(*) |
+------------------+
|                5 |
+------------------+
Total record(s): 1

query
SELECT COUNT(v) FROM na;
----
+------------------+
|         COUNT(v) |
+------------------+
|                3 |
+------------------+
Total record(s): 1

query
SELECT COUNT(w) FROM na;
----
+------------------+
|         COUNT(w) |
+------------------+
|                3 |
+------------------+
Total record(s): 1

query
SELECT COUNT(s) FROM na;
----
+------------------+
|         COUNT(s) |
+------------------+
|                3 |
+------------------+
Total record(s): 1

# COUNT(DISTINCT col) 不把 NULL 当成一个取值：v 的非 NULL 取值是 {10,20,30}
query
SELECT COUNT(DISTINCT v) AS dv FROM na;
----
+------------------+
|               dv |
+------------------+
|                3 |
+------------------+
Total record(s): 1

# s 的非 NULL 取值是 {a,c}，NULL 不计入
query
SELECT COUNT(DISTINCT s) AS ds FROM na;
----
+------------------+
|               ds |
+------------------+
|                2 |
+------------------+
Total record(s): 1

# MIN/MAX/SUM/AVG 跳过 NULL 输入，AVG 的分母也只算非 NULL 行（60/3 = 20）
query
SELECT MIN(v), MAX(v), SUM(v), AVG(v) FROM na;
----
+------------------+------------------+------------------+------------------+
|           MIN(v) |           MAX(v) |           SUM(v) |           AVG(v) |
+------------------+------------------+------------------+------------------+
|               10 |               30 |               60 |        20.000000 |
+------------------+------------------+------------------+------------------+
Total record(s): 1

query
SELECT MIN(s), MAX(s) FROM na;
----
+------------------+------------------+
|           MIN(s) |           MAX(s) |
+------------------+------------------+
|                a |                c |
+------------------+------------------+
Total record(s): 1

query
SELECT SUM(w), AVG(w) FROM na;
----
+------------------+------------------+
|           SUM(w) |           AVG(w) |
+------------------+------------------+
|         6.000000 |         2.000000 |
+------------------+------------------+
Total record(s): 1

# 空输入：按 finalv3 A.3 的测评约定，整数聚合输出 INT32 0；AVG 仍为 NULL。
query
SELECT COUNT(*), COUNT(v) FROM na WHERE g = 99;
----
+------------------+------------------+
|         COUNT(*) |         COUNT(v) |
+------------------+------------------+
|                0 |                0 |
+------------------+------------------+
Total record(s): 1

query
SELECT MIN(v), MAX(v), SUM(v), AVG(v) FROM na WHERE g = 99;
----
+------------------+------------------+------------------+------------------+
|           MIN(v) |           MAX(v) |           SUM(v) |           AVG(v) |
+------------------+------------------+------------------+------------------+
|                0 |                0 |                0 |             NULL |
+------------------+------------------+------------------+------------------+
Total record(s): 1

query
SELECT MIN(s) FROM na WHERE g = 99;
----
+------------------+
|           MIN(s) |
+------------------+
|             NULL |
+------------------+
Total record(s): 1

query
SELECT SUM(w) FROM na WHERE g = 99;
----
+------------------+
|           SUM(w) |
+------------------+
|             NULL |
+------------------+
Total record(s): 1

# 输入全是 NULL 不是真正的空输入，仍保留 NULL。
query
SELECT COUNT(v), SUM(v), AVG(v), MIN(v) FROM na WHERE v IS NULL;
----
+------------------+------------------+------------------+------------------+
|         COUNT(v) |           SUM(v) |           AVG(v) |           MIN(v) |
+------------------+------------------+------------------+------------------+
|                0 |             NULL |             NULL |             NULL |
+------------------+------------------+------------------+------------------+
Total record(s): 1

# 一个分组里全是 NULL：COUNT(*) 数行，其余聚合仍输出 NULL。
statement ok
INSERT INTO na VALUES (3, NULL, NULL, NULL);

query
SELECT g, COUNT(*), COUNT(v), SUM(v), MIN(v) FROM na WHERE g = 3 GROUP BY g;
----
+------------------+------------------+------------------+------------------+------------------+
|                g |         COUNT(*) |         COUNT(v) |           SUM(v) |           MIN(v) |
+------------------+------------------+------------------+------------------+------------------+
|                3 |                1 |                0 |             NULL |             NULL |
+------------------+------------------+------------------+------------------+------------------+
Total record(s): 1

query
SELECT g, COUNT(*), COUNT(v), SUM(v) FROM na GROUP BY g ORDER BY g;
----
+------------------+------------------+------------------+------------------+
|                g |         COUNT(*) |         COUNT(v) |           SUM(v) |
+------------------+------------------+------------------+------------------+
|                1 |                3 |                2 |               40 |
|                2 |                2 |                1 |               20 |
|                3 |                1 |                0 |             NULL |
+------------------+------------------+------------------+------------------+
Total record(s): 3

# GROUP BY 分组键为 NULL 时自成一组（ASC 时 NULL 排最后）
statement ok
CREATE TABLE ng (g INT, v INT);

statement ok
INSERT INTO ng VALUES (NULL, 1);

statement ok
INSERT INTO ng VALUES (NULL, 2);

statement ok
INSERT INTO ng VALUES (7, 3);

query
SELECT g, COUNT(*), SUM(v) FROM ng GROUP BY g ORDER BY g;
----
+------------------+------------------+------------------+
|                g |         COUNT(*) |           SUM(v) |
+------------------+------------------+------------------+
|                7 |                1 |                3 |
|             NULL |                2 |                3 |
+------------------+------------------+------------------+
Total record(s): 2

# HAVING：任一操作数为 NULL 则该组不通过（含 <>），g=3 的 SUM(v) 是 NULL。
query
SELECT g, SUM(v) FROM na GROUP BY g HAVING SUM(v) > 0 ORDER BY g;
----
+------------------+------------------+
|                g |           SUM(v) |
+------------------+------------------+
|                1 |               40 |
|                2 |               20 |
+------------------+------------------+
Total record(s): 2

query
SELECT g, SUM(v) FROM na GROUP BY g HAVING SUM(v) <> 0 ORDER BY g;
----
+------------------+------------------+
|                g |           SUM(v) |
+------------------+------------------+
|                1 |               40 |
|                2 |               20 |
+------------------+------------------+
Total record(s): 2

# min(col) 的索引有序捷径必须跳过前导 NULL 行（Delivery 的 min(no_o_id) 形状）
statement ok
CREATE TABLE nm (k INT, v INT);

statement ok
CREATE INDEX nm(v);

statement ok
INSERT INTO nm VALUES (1, NULL);

statement ok
INSERT INTO nm VALUES (2, 50);

statement ok
INSERT INTO nm VALUES (4, 70);

query
SELECT MIN(v) FROM nm;
----
+------------------+
|           MIN(v) |
+------------------+
|               50 |
+------------------+
Total record(s): 1

query
SELECT MIN(v) FROM nm WHERE v >= 0;
----
+------------------+
|           MIN(v) |
+------------------+
|               50 |
+------------------+
Total record(s): 1

query
SELECT COUNT(v), COUNT(*) FROM nm;
----
+------------------+------------------+
|         COUNT(v) |         COUNT(*) |
+------------------+------------------+
|                2 |                3 |
+------------------+------------------+
Total record(s): 1

# 索引是唯一索引，而 NULL 的索引键是全零字节，所以同一个可空索引列只能存一个
# NULL。TPC-C 的 10 个索引都不含可空列，所以这个限制不影响决赛路径。
statement error
INSERT INTO nm VALUES (5, NULL);


# ---------------------------------------------------------------------------
# min(col) 的索引序捷径：只有当 col 之前的每个索引列都被"普通字面量等值"钉死
# 时，索引序才在 col 上单调。`b IS NOT NULL` 被 get_clause 编码成
# op = OP_EQ / is_rhs_val = true / rhs_val.is_null，它不钉死 b，因此不能算作
# 前缀等值约束——否则捷径会把索引序的第一行当成最小值。

statement ok
CREATE TABLE nmi (a INT, b INT, c INT);

statement ok
CREATE INDEX nmi(a, b, c);

statement ok
INSERT INTO nmi VALUES (1, 5, 9);

statement ok
INSERT INTO nmi VALUES (1, 7, 1);

# a 被等值钉死，b 只是 IS NOT NULL：MIN(c) 必须扫完整个 a = 1 的范围
query
SELECT MIN(c) FROM nmi WHERE a = 1 AND b IS NOT NULL;
----
+------------------+
|           MIN(c) |
+------------------+
|                1 |
+------------------+
Total record(s): 1

# IS NULL 同理（没有行满足，整数聚合按空输入约定返回 0）
query
SELECT MIN(c) FROM nmi WHERE a = 1 AND b IS NULL;
----
+------------------+
|           MIN(c) |
+------------------+
|                0 |
+------------------+
Total record(s): 1

# 只有 a 的等值约束时 c 不是索引序的下一列，同样必须扫完
query
SELECT MIN(c) FROM nmi WHERE a = 1;
----
+------------------+
|           MIN(c) |
+------------------+
|                1 |
+------------------+
Total record(s): 1

# a、b 都被字面量等值钉死时捷径成立：索引序在 c 上单调
query
SELECT MIN(c) FROM nmi WHERE a = 1 AND b = 5;
----
+------------------+
|           MIN(c) |
+------------------+
|                9 |
+------------------+
Total record(s): 1
