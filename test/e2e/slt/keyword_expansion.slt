query
SELECT DISTINCT name FROM kw_people ORDER BY name;
----
+------------------+
|             name |
+------------------+
|           Alfred |
|            Alice |
|              Bob |
|            Carol |
|             Dave |
+------------------+
Total record(s): 5

query
SELECT name FROM kw_people WHERE name LIKE 'Al%';
----
+------------------+
|             name |
+------------------+
|            Alice |
|           Alfred |
+------------------+
Total record(s): 2

query
SELECT name FROM kw_people WHERE name NOT LIKE 'Al%';
----
+------------------+
|             name |
+------------------+
|              Bob |
|              Bob |
|            Carol |
|             Dave |
+------------------+
Total record(s): 4

query
SELECT name FROM kw_people WHERE name LIKE '_lice';
----
+------------------+
|             name |
+------------------+
|            Alice |
+------------------+
Total record(s): 1

