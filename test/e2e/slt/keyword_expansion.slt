Total record(s): 2

query
SELECT score, COUNT(*) AS n FROM kw_people GROUP BY score HAVING COUNT(*) > 1;
----
+------------------+------------------+
|            score |                n |
+------------------+------------------+
|               20 |                2 |
+------------------+------------------+
Total record(s): 1

query
SELECT score, COUNT(*) AS n FROM kw_people GROUP BY score HAVING score BETWEEN 10 AND 20 ORDER BY score;
----
+------------------+------------------+
|            score |                n |
+------------------+------------------+
|               10 |                1 |
|               20 |                2 |
+------------------+------------------+
Total record(s): 2

query
SELECT name, COUNT(*) AS n FROM kw_people GROUP BY name HAVING name LIKE 'Al%' ORDER BY name;
----
+------------------+------------------+
|             name |                n |
+------------------+------------------+
|           Alfred |                1 |
|            Alice |                1 |
+------------------+------------------+
Total record(s): 2

query
SELECT score, COUNT(*) AS n FROM kw_people GROUP BY score HAVING score IN (10, 50) ORDER BY score;
