query
SELECT kw_left.id AS left_id, kw_right.id AS right_id
FROM kw_left RIGHT JOIN kw_right ON kw_left.id = kw_right.id;
----
+------------------+------------------+
|          left_id |         right_id |
+------------------+------------------+
|                2 |                2 |
|             NULL |                3 |
+------------------+------------------+
Total record(s): 2

query
SELECT kw_left.id AS left_id, kw_right.id AS right_id
FROM kw_left RIGHT JOIN kw_right ON kw_left.id = kw_right.id AND kw_right.id > 2;
----
+------------------+------------------+
|          left_id |         right_id |
+------------------+------------------+
|             NULL |                2 |
|             NULL |                3 |
+------------------+------------------+
Total record(s): 2

query
SELECT kw_left.id AS left_id, kw_right.id AS right_id
FROM kw_left FULL OUTER JOIN kw_right ON kw_left.id = kw_right.id;
----
+------------------+------------------+
|          left_id |         right_id |
+------------------+------------------+
|                1 |             NULL |
|                2 |                2 |
|             NULL |                3 |
+------------------+------------------+
Total record(s): 3

query
SELECT kw_left.id AS left_id, kw_right.id AS right_id
FROM kw_left RIGHT JOIN kw_right ON kw_left.id = kw_right.id
WHERE kw_left.id > 0;
----
+------------------+------------------+
|          left_id |         right_id |
+------------------+------------------+
|                2 |                2 |
+------------------+------------------+
Total record(s): 1

query
SELECT kw_right.id FROM kw_left RIGHT JOIN kw_right ON kw_left.id = kw_right.id
WHERE kw_left.label LIKE 'L%';
----
+------------------+
|               id |
+------------------+
|                2 |
+------------------+
Total record(s): 1

query
SELECT kw_left.id AS left_id, kw_right.id AS right_id
FROM kw_left RIGHT JOIN kw_right ON kw_left.id = kw_right.id
WHERE kw_left.id = kw_right.id;
----
+------------------+------------------+
|          left_id |         right_id |
+------------------+------------------+
|                2 |                2 |
+------------------+------------------+
Total record(s): 1

query
SELECT kw_left.id AS left_id, COUNT(*) AS n
FROM kw_left RIGHT JOIN kw_right ON kw_left.id = kw_right.id
GROUP BY kw_left.id ORDER BY left_id;
----
+------------------+------------------+
|          left_id |                n |
+------------------+------------------+
|             NULL |                1 |
|                2 |                1 |
+------------------+------------------+
Total record(s): 2

query
SELECT kw_left.id AS left_id, COUNT(*) AS n
FROM kw_left RIGHT JOIN kw_right ON kw_left.id = kw_right.id
GROUP BY kw_left.id HAVING kw_left.id = 0;
----
+------------------+------------------+
|          left_id |                n |
+------------------+------------------+
+------------------+------------------+
Total record(s): 0

query
SELECT kw_left.id AS left_id, kw_right.id AS right_id, kw_third.id AS third_id
FROM kw_left RIGHT JOIN kw_right ON kw_left.id = kw_right.id
JOIN kw_third ON kw_right.id = kw_third.id ORDER BY third_id;
----
+------------------+------------------+------------------+
|          left_id |         right_id |         third_id |
+------------------+------------------+------------------+
|                2 |                2 |                2 |
|             NULL |                3 |                3 |
+------------------+------------------+------------------+
Total record(s): 2

query
SELECT * FROM (
    SELECT id FROM kw_left
    UNION ALL
    SELECT id FROM kw_left
) AS all_ids ORDER BY id;
----
+------------------+
|               id |
+------------------+
|                1 |
|                1 |
|                2 |
|                2 |
+------------------+
Total record(s): 4

query
SELECT * FROM (
    SELECT id FROM kw_left
    UNION
    SELECT id FROM kw_left
) AS unique_ids ORDER BY id;
----
+------------------+
|               id |
+------------------+
|                1 |
|                2 |
+------------------+
Total record(s): 2

query
SELECT * FROM (
    SELECT id FROM kw_left
    UNION ALL
    SELECT id FROM kw_left
    UNION
    SELECT id FROM kw_left
) AS mixed_ids ORDER BY id;
----
+------------------+
|               id |
+------------------+
|                1 |
|                2 |
+------------------+
Total record(s): 2

query
SELECT * FROM (
    SELECT id FROM kw_left
    UNION ALL
    SELECT id FROM kw_left
) AS paged_ids ORDER BY id LIMIT 2 OFFSET 1;
----
+------------------+
|               id |
+------------------+
|                1 |
|                2 |
+------------------+
Total record(s): 2

