# Test 7: CharColumnJoin
# ============================================================

statement ok
DROP TABLE a;

statement ok
DROP TABLE b;

statement ok
CREATE TABLE a (code char(10), val int);

statement ok
CREATE TABLE b (id int, code char(10));

statement ok
INSERT INTO a VALUES ('ABC', 1);

statement ok
INSERT INTO a VALUES ('DEF', 2);

statement ok
INSERT INTO b VALUES (10, 'ABC');

statement ok
INSERT INTO b VALUES (20, 'XYZ');

# NLJ phase — SELECT (1 matching row: code='ABC')

query
SELECT a.val, b.id FROM a JOIN b ON a.code = b.code;
----
+------------------+------------------+
|              val |               id |
+------------------+------------------+
|                1 |               10 |
+------------------+------------------+
Total record(s): 1

# INLJ phase — create index on code

statement ok
CREATE INDEX b(code);

# INLJ phase — SELECT (1 matching row)

query
SELECT a.val, b.id FROM a JOIN b ON a.code = b.code;
----
+------------------+------------------+
|              val |               id |
+------------------+------------------+
|                1 |               10 |
+------------------+------------------+
Total record(s): 1

# INLJ phase — EXPLAIN ANALYZE (IndexScan on code)

query
EXPLAIN ANALYZE SELECT a.val, b.id FROM a JOIN b ON a.code = b.code;
----
Project(columns=[a.val, b.id], rows=1)
	Join(tables=[a, b], condition=[a.code=b.code], rows=1)
		Project(columns=[a.code, a.val], rows=2)
			Scan(table=a, type=SeqScan, rows=2)
		Project(columns=[b.code, b.id], rows=1)
			Scan(table=b, type=IndexScan, using_index=(code), rows=1)

