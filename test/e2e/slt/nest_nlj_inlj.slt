# ============================================================

statement ok
DROP TABLE employees;

statement ok
DROP TABLE departments;

statement ok
CREATE TABLE departments (dept_id int, dept_name char(20));

statement ok
CREATE TABLE employees (emp_id int, dept_id int, emp_name char(20));

statement ok
CREATE TABLE offices (office_id int, dept_id int, office_name char(20));

statement ok
INSERT INTO departments VALUES (10, 'Finance');

statement ok
INSERT INTO departments VALUES (20, 'HR');

statement ok
INSERT INTO departments VALUES (30, 'Sales');

statement ok
INSERT INTO employees VALUES (1, 10, 'Alice');

statement ok
INSERT INTO employees VALUES (2, 20, 'Bob');

statement ok
INSERT INTO employees VALUES (3, 30, 'Charlie');

statement ok
INSERT INTO offices VALUES (101, 10, 'HQ');

statement ok
INSERT INTO offices VALUES (102, 20, 'Remote');

statement ok
INSERT INTO offices VALUES (103, 30, 'Field');

# NLJ phase — SELECT

query
SELECT departments.dept_name, employees.emp_name, offices.office_name FROM departments JOIN employees ON departments.dept_id = employees.dept_id JOIN offices ON departments.dept_id = offices.dept_id;
----
+------------------+------------------+------------------+
|        dept_name |         emp_name |      office_name |
+------------------+------------------+------------------+
|          Finance |            Alice |               HQ |
|               HR |              Bob |           Remote |
|            Sales |          Charlie |            Field |
+------------------+------------------+------------------+
Total record(s): 3

# NLJ phase — EXPLAIN ANALYZE

query
EXPLAIN ANALYZE SELECT departments.dept_name, employees.emp_name, offices.office_name FROM departments JOIN employees ON departments.dept_id = employees.dept_id JOIN offices ON departments.dept_id = offices.dept_id;
----
Project(columns=[departments.dept_name, employees.emp_name, offices.office_name], rows=3)
	Join(tables=[departments, employees, offices], condition=[departments.dept_id=offices.dept_id], rows=3)
		Join(tables=[departments, employees], condition=[departments.dept_id=employees.dept_id], rows=3)
			Project(columns=[departments.dept_id, departments.dept_name], rows=3)
				Scan(table=departments, type=SeqScan, rows=3)
			Project(columns=[employees.dept_id, employees.emp_name], rows=9)
				Scan(table=employees, type=SeqScan, rows=9)
		Project(columns=[offices.dept_id, offices.office_name], rows=9)
			Scan(table=offices, type=SeqScan, rows=9)

# INLJ phase — create indexes

statement ok
CREATE INDEX employees(dept_id);

statement ok
CREATE INDEX offices(dept_id);

# INLJ phase — SELECT

query
SELECT departments.dept_name, employees.emp_name, offices.office_name FROM departments JOIN employees ON departments.dept_id = employees.dept_id JOIN offices ON departments.dept_id = offices.dept_id;
----
+------------------+------------------+------------------+
|        dept_name |         emp_name |      office_name |
+------------------+------------------+------------------+
|          Finance |            Alice |               HQ |
|               HR |              Bob |           Remote |
|            Sales |          Charlie |            Field |
+------------------+------------------+------------------+
Total record(s): 3

# INLJ phase — EXPLAIN ANALYZE

query
EXPLAIN ANALYZE SELECT departments.dept_name, employees.emp_name, offices.office_name FROM departments JOIN employees ON departments.dept_id = employees.dept_id JOIN offices ON departments.dept_id = offices.dept_id;
----
Project(columns=[departments.dept_name, employees.emp_name, offices.office_name], rows=3)
	Join(tables=[departments, employees, offices], condition=[departments.dept_id=offices.dept_id], rows=3)
		Join(tables=[departments, employees], condition=[departments.dept_id=employees.dept_id], rows=3)
			Project(columns=[departments.dept_id, departments.dept_name], rows=3)
				Scan(table=departments, type=SeqScan, rows=3)
			Project(columns=[employees.dept_id, employees.emp_name], rows=3)
				Scan(table=employees, type=IndexScan, using_index=(dept_id), rows=3)
		Project(columns=[offices.dept_id, offices.office_name], rows=3)
			Scan(table=offices, type=IndexScan, using_index=(dept_id), rows=3)

