# NLJ phase — SELECT (3 result rows)

query
SELECT t1.id FROM t1 JOIN t2 ON t1.id = t2.t1_id JOIN t3 ON t1.id = t3.t1_id JOIN t4 ON t1.id = t4.t1_id JOIN t5 ON t1.id = t5.t1_id;
----
+------------------+
|               id |
+------------------+
|                1 |
|                2 |
|                3 |
+------------------+
Total record(s): 3

# NLJ phase — EXPLAIN ANALYZE (4 Join nodes for 5-table join)

query
EXPLAIN ANALYZE SELECT t1.id FROM t1 JOIN t2 ON t1.id = t2.t1_id JOIN t3 ON t1.id = t3.t1_id JOIN t4 ON t1.id = t4.t1_id JOIN t5 ON t1.id = t5.t1_id;
----
Project(columns=[t1.id], rows=3)
	Join(tables=[t1, t2, t3, t4, t5], condition=[t1.id=t5.t1_id], rows=3)
		Join(tables=[t1, t2, t3, t4], condition=[t1.id=t4.t1_id], rows=3)
			Join(tables=[t1, t2, t3], condition=[t1.id=t3.t1_id], rows=3)
				Join(tables=[t1, t2], condition=[t1.id=t2.t1_id], rows=3)
					Project(columns=[t1.id], rows=3)
						Scan(table=t1, type=SeqScan, rows=3)
					Project(columns=[t2.t1_id], rows=9)
						Scan(table=t2, type=SeqScan, rows=9)
				Project(columns=[t3.t1_id], rows=9)
					Scan(table=t3, type=SeqScan, rows=9)
			Project(columns=[t4.t1_id], rows=9)
				Scan(table=t4, type=SeqScan, rows=9)
		Project(columns=[t5.t1_id], rows=9)
			Scan(table=t5, type=SeqScan, rows=9)

# INLJ phase — create indexes

statement ok
CREATE INDEX t2(t1_id);

statement ok
CREATE INDEX t3(t1_id);

statement ok
CREATE INDEX t4(t1_id);

statement ok
CREATE INDEX t5(t1_id);

# INLJ phase — SELECT (3 result rows)

query
SELECT t1.id FROM t1 JOIN t2 ON t1.id = t2.t1_id JOIN t3 ON t1.id = t3.t1_id JOIN t4 ON t1.id = t4.t1_id JOIN t5 ON t1.id = t5.t1_id;
----
+------------------+
|               id |
+------------------+
|                1 |
|                2 |
|                3 |
+------------------+
Total record(s): 3

# INLJ phase — EXPLAIN ANALYZE (4 IndexScan nodes)

query
EXPLAIN ANALYZE SELECT t1.id FROM t1 JOIN t2 ON t1.id = t2.t1_id JOIN t3 ON t1.id = t3.t1_id JOIN t4 ON t1.id = t4.t1_id JOIN t5 ON t1.id = t5.t1_id;
----
Project(columns=[t1.id], rows=3)
	Join(tables=[t1, t2, t3, t4, t5], condition=[t1.id=t5.t1_id], rows=3)
		Join(tables=[t1, t2, t3, t4], condition=[t1.id=t4.t1_id], rows=3)
			Join(tables=[t1, t2, t3], condition=[t1.id=t3.t1_id], rows=3)
				Join(tables=[t1, t2], condition=[t1.id=t2.t1_id], rows=3)
					Project(columns=[t1.id], rows=3)
						Scan(table=t1, type=SeqScan, rows=3)
					Project(columns=[t2.t1_id], rows=3)
						Scan(table=t2, type=IndexScan, using_index=(t1_id), rows=3)
				Project(columns=[t3.t1_id], rows=3)
					Scan(table=t3, type=IndexScan, using_index=(t1_id), rows=3)
			Project(columns=[t4.t1_id], rows=3)
				Scan(table=t4, type=IndexScan, using_index=(t1_id), rows=3)
		Project(columns=[t5.t1_id], rows=3)
			Scan(table=t5, type=IndexScan, using_index=(t1_id), rows=3)
