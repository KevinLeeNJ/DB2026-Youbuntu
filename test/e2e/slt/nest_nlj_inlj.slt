# Test 5: SelectStarJoin
# ============================================================

statement ok
DROP TABLE left_t;

statement ok
DROP TABLE right_t;

statement ok
CREATE TABLE a (id int, val int);

statement ok
CREATE TABLE b (id int, a_id int);

statement ok
INSERT INTO a VALUES (1, 100);

statement ok
INSERT INTO a VALUES (2, 200);

statement ok
INSERT INTO b VALUES (10, 1);

statement ok
INSERT INTO b VALUES (20, 2);

# NLJ phase — EXPLAIN ANALYZE (SELECT * shows Project(columns=[*]))

query
EXPLAIN ANALYZE SELECT * FROM a JOIN b ON a.id = b.a_id;
----
Project(columns=[*], rows=2)
	Join(tables=[a, b], condition=[a.id=b.a_id], rows=2)
		Scan(table=a, type=SeqScan, rows=2)
		Scan(table=b, type=SeqScan, rows=4)

# INLJ phase — create index

statement ok
CREATE INDEX b(a_id);

# INLJ phase — EXPLAIN ANALYZE

query
EXPLAIN ANALYZE SELECT * FROM a JOIN b ON a.id = b.a_id;
----
Project(columns=[*], rows=2)
	Join(tables=[a, b], condition=[a.id=b.a_id], rows=2)
		Scan(table=a, type=SeqScan, rows=2)
		Scan(table=b, type=IndexScan, using_index=(a_id), rows=2)

# ============================================================
# Test 6: JoinMultipleConditions
# ============================================================

statement ok
DROP TABLE a;

statement ok
DROP TABLE b;

statement ok
CREATE TABLE a (id int, x int);

statement ok
CREATE TABLE b (id int, a_id int, x int);

statement ok
INSERT INTO a VALUES (1, 10);

statement ok
INSERT INTO a VALUES (2, 20);

statement ok
INSERT INTO b VALUES (100, 1, 10);

statement ok
INSERT INTO b VALUES (200, 2, 99);

# Create index only on a_id (INLJ on a_id, residual filter on x)

statement ok
CREATE INDEX b(a_id);

# SELECT with multi-condition join (1 matching row: a.id=1,b.id=100)

query
SELECT a.id, b.id FROM a JOIN b ON a.id = b.a_id AND a.x = b.x;
----
+------------------+------------------+
|               id |               id |
+------------------+------------------+
|                1 |              100 |
+------------------+------------------+
Total record(s): 1

# EXPLAIN ANALYZE (IndexScan on a_id, both conditions preserved)

query
EXPLAIN ANALYZE SELECT a.id, b.id FROM a JOIN b ON a.id = b.a_id AND a.x = b.x;
----
Project(columns=[a.id, b.id], rows=1)
	Join(tables=[a, b], condition=[a.id=b.a_id, a.x=b.x], rows=1)
		Project(columns=[a.id, a.x], rows=2)
			Scan(table=a, type=SeqScan, rows=2)
		Project(columns=[b.a_id, b.id, b.x], rows=2)
			Scan(table=b, type=IndexScan, using_index=(a_id), rows=2)

