		Project(columns=[left_t.id], rows=2)
			Scan(table=left_t, type=SeqScan, rows=2)
		Project(columns=[right_t.id, right_t.ref], rows=2)
			Scan(table=right_t, type=IndexScan, using_index=(ref), rows=2)

