statement ok
CREATE TABLE right_t (id int, ref int, val char(10));

statement ok
INSERT INTO left_t VALUES (1, 'L1');

statement ok
INSERT INTO left_t VALUES (2, 'L2');

statement ok
INSERT INTO left_t VALUES (3, 'L3');

statement ok
INSERT INTO right_t VALUES (10, 100, 'R1');

statement ok
INSERT INTO right_t VALUES (20, 200, 'R2');

# NLJ phase — SELECT (0 result rows)

query
SELECT left_t.id, right_t.id FROM left_t JOIN right_t ON left_t.id = right_t.ref;
----
+------------------+------------------+
|               id |               id |
+------------------+------------------+
+------------------+------------------+
Total record(s): 0

# NLJ phase — EXPLAIN ANALYZE (right SeqScan rows = 3*2 = 6)

query
EXPLAIN ANALYZE SELECT left_t.id, right_t.id FROM left_t JOIN right_t ON left_t.id = right_t.ref;
----
Project(columns=[left_t.id, right_t.id], rows=0)
	Join(tables=[left_t, right_t], condition=[left_t.id=right_t.ref], rows=0)
		Project(columns=[left_t.id], rows=3)
			Scan(table=left_t, type=SeqScan, rows=3)
		Project(columns=[right_t.id, right_t.ref], rows=6)
			Scan(table=right_t, type=SeqScan, rows=6)

# INLJ phase — create index

statement ok
CREATE INDEX right_t(ref);

# INLJ phase — SELECT (0 result rows)

query
SELECT left_t.id, right_t.id FROM left_t JOIN right_t ON left_t.id = right_t.ref;
----
+------------------+------------------+
|               id |               id |
+------------------+------------------+
+------------------+------------------+
Total record(s): 0

# INLJ phase — EXPLAIN ANALYZE (IndexScan rows=0)

query
EXPLAIN ANALYZE SELECT left_t.id, right_t.id FROM left_t JOIN right_t ON left_t.id = right_t.ref;
----
Project(columns=[left_t.id, right_t.id], rows=0)
	Join(tables=[left_t, right_t], condition=[left_t.id=right_t.ref], rows=0)
		Project(columns=[left_t.id], rows=3)
			Scan(table=left_t, type=SeqScan, rows=3)
		Project(columns=[right_t.id, right_t.ref], rows=0)
			Scan(table=right_t, type=IndexScan, using_index=(ref), rows=0)

