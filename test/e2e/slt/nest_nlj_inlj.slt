# nest_nlj_inlj.slt — NLJ → INLJ optimization E2E tests
# Covers: TwoTableFullMatch, ThreeTableJoin, TwoTableNoMatch,
#         TwoTablePartialMatch, SelectStarJoin, JoinMultipleConditions,
#         CharColumnJoin, FiveTableJoin

# ============================================================
# Test 1: TwoTableFullMatch (Nest.md §3.1.2 + §3.1.3)
# ============================================================

statement ok
CREATE TABLE departments (dept_id int, dept_name char(20));

statement ok
CREATE TABLE employees (emp_id int, dept_id int, emp_name char(20), salary int);

statement ok
INSERT INTO departments VALUES (10, 'Finance');

statement ok
INSERT INTO departments VALUES (20, 'HR');

statement ok
INSERT INTO departments VALUES (30, 'Sales');

statement ok
INSERT INTO departments VALUES (40, 'Engineering');

statement ok
INSERT INTO departments VALUES (50, 'Marketing');

statement ok
INSERT INTO employees VALUES (1, 10, 'Alice', 65000);

statement ok
INSERT INTO employees VALUES (2, 20, 'Bob', 48000);

statement ok
INSERT INTO employees VALUES (3, 30, 'Charlie', 52000);

statement ok
INSERT INTO employees VALUES (4, 40, 'Diana', 70000);

statement ok
INSERT INTO employees VALUES (5, 50, 'Eve', 55000);

# NLJ phase — SELECT

query
SELECT departments.dept_name, employees.emp_name FROM departments JOIN employees ON departments.dept_id = employees.dept_id;
----
+------------------+------------------+
|        dept_name |         emp_name |
+------------------+------------------+
|          Finance |            Alice |
|               HR |              Bob |
|            Sales |          Charlie |
|      Engineering |            Diana |
|        Marketing |              Eve |
+------------------+------------------+
Total record(s): 5

# NLJ phase — EXPLAIN ANALYZE

query
EXPLAIN ANALYZE SELECT departments.dept_name, employees.emp_name FROM departments JOIN employees ON departments.dept_id = employees.dept_id;
----
Project(columns=[departments.dept_name, employees.emp_name], rows=5)
	Join(tables=[departments, employees], condition=[departments.dept_id=employees.dept_id], rows=5)
		Project(columns=[departments.dept_id, departments.dept_name], rows=5)
			Scan(table=departments, type=SeqScan, rows=5)
		Project(columns=[employees.dept_id, employees.emp_name], rows=25)
			Scan(table=employees, type=SeqScan, rows=25)

# INLJ phase — create index on inner table

statement ok
CREATE INDEX employees(dept_id);

# INLJ phase — SELECT

query
SELECT departments.dept_name, employees.emp_name FROM departments JOIN employees ON departments.dept_id = employees.dept_id;
----
+------------------+------------------+
|        dept_name |         emp_name |
+------------------+------------------+
|          Finance |            Alice |
|               HR |              Bob |
|            Sales |          Charlie |
|      Engineering |            Diana |
|        Marketing |              Eve |
+------------------+------------------+
Total record(s): 5

# INLJ phase — EXPLAIN ANALYZE

query
EXPLAIN ANALYZE SELECT departments.dept_name, employees.emp_name FROM departments JOIN employees ON departments.dept_id = employees.dept_id;
----
Project(columns=[departments.dept_name, employees.emp_name], rows=5)
	Join(tables=[departments, employees], condition=[departments.dept_id=employees.dept_id], rows=5)
		Project(columns=[departments.dept_id, departments.dept_name], rows=5)
			Scan(table=departments, type=SeqScan, rows=5)
		Project(columns=[employees.dept_id, employees.emp_name], rows=5)
			Scan(table=employees, type=IndexScan, using_index=(dept_id), rows=5)

