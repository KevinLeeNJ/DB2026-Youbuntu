CREATE TABLE t4 (id int, t1_id int);

statement ok
CREATE TABLE t5 (id int, t1_id int);

statement ok
INSERT INTO t1 VALUES (1);

statement ok
INSERT INTO t1 VALUES (2);

statement ok
INSERT INTO t1 VALUES (3);

statement ok
INSERT INTO t2 VALUES (10, 1);

statement ok
INSERT INTO t2 VALUES (20, 2);

statement ok
INSERT INTO t2 VALUES (30, 3);

statement ok
INSERT INTO t3 VALUES (100, 1);

statement ok
INSERT INTO t3 VALUES (200, 2);

statement ok
INSERT INTO t3 VALUES (300, 3);

statement ok
INSERT INTO t4 VALUES (1000, 1);

