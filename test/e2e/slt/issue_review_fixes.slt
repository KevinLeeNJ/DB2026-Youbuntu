query
SELECT a.id AS a_id, b.id AS b_id, c.id AS c_id
FROM review_join_a AS a, review_join_b AS b
JOIN review_join_c AS c ON b.id + 0 = c.id
WHERE a.id = b.id
ORDER BY a.id;
