# issue_review_fixes.slt — regression coverage for confirmed review findings

statement ok
CREATE TABLE review_people (id INT, score INT, ratio FLOAT);

statement ok
INSERT INTO review_people VALUES (1, 10, 1.5);

statement ok
INSERT INTO review_people VALUES (2, 20, 2.5);

statement ok
UPDATE review_people SET score = CASE WHEN id = 1 THEN 30 ELSE 40 END;

query
SELECT id, score FROM review_people ORDER BY id;
----
+------------------+------------------+
|               id |            score |
+------------------+------------------+
|                1 |               30 |
|                2 |               40 |
+------------------+------------------+
Total record(s): 2

query
SELECT id, score + 1 AS next_score FROM review_people ORDER BY id;
----
+------------------+------------------+
|               id |       next_score |
+------------------+------------------+
|                1 |               31 |
|                2 |               41 |
+------------------+------------------+
Total record(s): 2

query
SELECT id, ratio + score AS total FROM review_people ORDER BY id;
----
+------------------+------------------+
|               id |            total |
+------------------+------------------+
|                1 |        31.500000 |
|                2 |        42.500000 |
+------------------+------------------+
Total record(s): 2

query
SELECT id, 1 + 2 * 3 AS value FROM review_people WHERE id = 1;
----
+------------------+------------------+
|               id |            value |
+------------------+------------------+
|                1 |                7 |
+------------------+------------------+
Total record(s): 1

