query
SELECT l.id AS left_id, r.id AS right_id
FROM review_left AS l JOIN review_right AS r
ON EXISTS (SELECT 1 FROM review_ids WHERE review_ids.id = l.id)
ORDER BY l.id;
----
+------------------+------------------+
|          left_id |         right_id |
+------------------+------------------+
|                1 |                2 |
|                2 |                2 |
+------------------+------------------+
Total record(s): 2

statement ok
CREATE INDEX review_right(id);

query
EXPLAIN ANALYZE SELECT l.id, r.id FROM review_left AS l LEFT JOIN review_right AS r ON l.id = r.id;
----
Project(columns=[l.id, r.id], rows=2)
	Join(tables=[review_left, review_right], condition=[l.id=r.id], rows=2)
		Project(columns=[l.id], rows=2)
			Scan(table=review_left, type=SeqScan, rows=2)
		Project(columns=[r.id], rows=1)
			Scan(table=review_right, type=SeqScan, rows=1)
