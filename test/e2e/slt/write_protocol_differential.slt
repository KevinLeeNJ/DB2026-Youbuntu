# write_protocol_differential.slt — 写路径差分基线
#
# 在 Phase 4 重构写路径前录制，作为 TableWriteService 迁移后的差分对照。
# 覆盖 4 项可观察语义：
#   1. insert 唯一性冲突（IndexEntryExistsError）
#   2. delete rollback（abort 后行恢复，索引可查）
#   3. update 索引列修改（旧索引项消失，新索引项出现）
#   4. update rollback（abort 后旧值恢复，索引按旧值可查）
#
# 注意：RMDB 的 CREATE INDEX 创建的是 unique 索引，故测试中索引列值唯一。
# 跨事务 WW_CONFLICT 抛 TransactionAbortException（非 RMDBError），无法用
# `statement error` 表达，故未在此 SLT 覆盖。LOAD DATA 含重启恢复的差分由
# e2e_test.cpp 中的 LoadCrashRecoveryTest 单独覆盖（需要跨进程重启）。

# === 1. insert 唯一性冲突 ===

statement ok
CREATE TABLE wp_unique (id INT, v INT);

statement ok
CREATE INDEX wp_unique(id);

statement ok
INSERT INTO wp_unique VALUES (1, 10);

# 重复 id 触发 IndexEntryExistsError
statement error
INSERT INTO wp_unique VALUES (1, 20);

# 冲突不持久化，表内仍只有一行
query
SELECT COUNT(*) FROM wp_unique;
----
+------------------+
|         COUNT(*) |
+------------------+
|                1 |
+------------------+
Total record(s): 1

# === 2. delete rollback ===

statement ok
CREATE TABLE wp_del (id INT, v INT);

statement ok
CREATE INDEX wp_del(id);

statement ok
INSERT INTO wp_del VALUES (1, 100);

statement ok
INSERT INTO wp_del VALUES (2, 200);

statement ok
BEGIN;

statement ok
DELETE FROM wp_del WHERE id = 1;

statement ok
ABORT;

# abort 后两行均恢复，索引按 id 可查
query
SELECT COUNT(*) FROM wp_del;
----
+------------------+
|         COUNT(*) |
+------------------+
|                2 |
+------------------+
Total record(s): 1

query
SELECT v FROM wp_del WHERE id = 1;
----
+------------------+
|                v |
+------------------+
|              100 |
+------------------+
Total record(s): 1

# === 3. update 索引列修改 ===

statement ok
CREATE TABLE wp_upd (id INT, cat INT);

statement ok
CREATE INDEX wp_upd(cat);

statement ok
INSERT INTO wp_upd VALUES (1, 5);

statement ok
INSERT INTO wp_upd VALUES (2, 7);

statement ok
UPDATE wp_upd SET cat = 6 WHERE id = 1;

# 旧索引项 cat=5 消失；新索引项 cat=6 出现
query
SELECT id FROM wp_upd WHERE cat = 5;
----
+------------------+
|               id |
+------------------+
+------------------+
Total record(s): 0

query
SELECT id FROM wp_upd WHERE cat = 6;
----
+------------------+
|               id |
+------------------+
|                1 |
+------------------+
Total record(s): 1

# === 4. update rollback（写路径 undo 正确性）===

statement ok
CREATE TABLE wp_rollback (id INT, cat INT);

statement ok
CREATE INDEX wp_rollback(cat);

statement ok
INSERT INTO wp_rollback VALUES (1, 5);

statement ok
BEGIN;

statement ok
UPDATE wp_rollback SET cat = 6 WHERE id = 1;

statement ok
ABORT;

# abort 后旧值恢复：cat=5 可查，cat=6 不可查
query
SELECT id FROM wp_rollback WHERE cat = 5;
----
+------------------+
|               id |
+------------------+
|                1 |
+------------------+
Total record(s): 1

query
SELECT COUNT(*) FROM wp_rollback WHERE cat = 6;
----
+------------------+
|         COUNT(*) |
+------------------+
|                0 |
+------------------+
Total record(s): 1

statement ok
DROP TABLE wp_unique;

statement ok
DROP TABLE wp_del;

statement ok
DROP TABLE wp_upd;

statement ok
DROP TABLE wp_rollback;
