# basic_create.slt — DDL tests: CREATE TABLE, DROP TABLE, DESC, SHOW TABLES

statement ok
CREATE TABLE t1 (a INT, b FLOAT, c CHAR(20));

# Verify SHOW TABLES output
query
SHOW TABLES;
----
+------------------+
|           Tables |
+------------------+
|               t1 |
+------------------+

# Verify DESC output
query
DESC t1;
----
+------------------+------------------+------------------+
|            Field |             Type |            Index |
+------------------+------------------+------------------+
|                a |              INT |               NO |
|                b |            FLOAT |               NO |
|                c |           STRING |               NO |
+------------------+------------------+------------------+

# Create another table
statement ok
CREATE TABLE t2 (id INT, name CHAR(10), score FLOAT);

# SHOW TABLES should now list both
query
SHOW TABLES;
----
+------------------+
|           Tables |
+------------------+
|               t1 |
|               t2 |
+------------------+

# Drop a table
statement ok
DROP TABLE t2;

# Only t1 remains
query
SHOW TABLES;
----
+------------------+
|           Tables |
+------------------+
|               t1 |
+------------------+

# DESC the remaining table
query
DESC t1;
----
+------------------+------------------+------------------+
|            Field |             Type |            Index |
+------------------+------------------+------------------+
|                a |              INT |               NO |
|                b |            FLOAT |               NO |
|                c |           STRING |               NO |
+------------------+------------------+------------------+

# Drop non-existent table should error
statement error
DROP TABLE nonexistent;

statement ok
CREATE TABLE events (id INT, created_at DATETIME);

query
DESC events;
----
+------------------+------------------+------------------+
|            Field |             Type |            Index |
+------------------+------------------+------------------+
|               id |              INT |               NO |
|       created_at |         DATETIME |               NO |
+------------------+------------------+------------------+

statement ok
INSERT INTO events VALUES (1, '2026-06-27 12:34:56');

statement ok
INSERT INTO events VALUES (2, '2026-06-26 01:02:03');

query
SELECT id, created_at FROM events;
----
+------------------+------------------+
|               id |       created_at |
+------------------+------------------+
|                1 | 2026-06-27 12... |
|                2 | 2026-06-26 01... |
+------------------+------------------+
Total record(s): 2

query
SELECT id, created_at FROM events ORDER BY created_at;
----
+------------------+------------------+
|               id |       created_at |
+------------------+------------------+
|                2 | 2026-06-26 01... |
|                1 | 2026-06-27 12... |
+------------------+------------------+
Total record(s): 2

statement ok
CREATE INDEX events(created_at);

query
SELECT id FROM events WHERE created_at = '2026-06-27 12:34:56';
----
+------------------+
|               id |
+------------------+
|                1 |
+------------------+
Total record(s): 1
